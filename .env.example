# Copy to .env.local for local work. Never commit real values.
# On Vercel, set these under Project Settings > Environment Variables.
# Only the anon (public) key goes here; it is safe in the browser because
# row-level security enforces company isolation. NEVER put the service_role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-side only (set these in Vercel; NEVER prefix them with VITE_) ---
# QuickBooks connection (see README, "Connecting QuickBooks")
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
INTUIT_REDIRECT_URI=https://YOUR-SITE.vercel.app/api/qb/callback
INTUIT_ENV=sandbox
APP_URL=https://YOUR-SITE.vercel.app
# A long random string used to sign sign-in links and encrypt stored tokens
INTEGRATIONS_SECRET=
# Supabase "service role" key: bypasses all row-level security, so it must stay on the server
SUPABASE_SERVICE_ROLE_KEY=
