# Copy to .env.local for local work. Never commit real values.
# On Vercel, set these under Project Settings > Environment Variables.
# Only the anon (public) key goes here; it is safe in the browser because
# row-level security enforces company isolation. NEVER put the service_role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
